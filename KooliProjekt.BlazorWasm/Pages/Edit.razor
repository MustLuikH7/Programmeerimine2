@page "/create"
@page "/edit/{UserId:int}"

@inject KooliProjekt.BlazorWasm.IApiClient apiClient
@inject NavigationManager NavManager

<h3>@title</h3>

<EditForm EditContext="editContext" OnSubmit="@FormSubmitted">
    <ValidationSummary />
    <p class="alert-danger">@error</p>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Eesnimi</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="user.FirstName" />
            <ValidationMessage For="@(() => user.FirstName)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Perenimi</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="user.LastName" />
            <ValidationMessage For="@(() => user.LastName)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">E-post</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="user.Email" />
            <ValidationMessage For="@(() => user.Email)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Telefon</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="user.Phone" />
            <ValidationMessage For="@(() => user.Phone)" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-ms-2 col-form-label"></label>
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int UserId { get; set; }

    private string error = "";
    private string title = "Edit";
    private EditContext? editContext;
    private KooliProjekt.BlazorWasm.Users user = new KooliProjekt.BlazorWasm.Users();

    private ValidationMessageStore? messageStore;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(user);
        messageStore = new ValidationMessageStore(editContext);

        if (UserId == 0)
        {
            title = "Add";
            return;
        }

        var response = await apiClient.Get(UserId);
        if (!response.HasErrors)
        {
            user = response.Value;
            editContext = new EditContext(user);
            messageStore = new ValidationMessageStore(editContext);
        }
    }

    private async Task FormSubmitted()
    {
        // Eemalda eelnevad veateated
        messageStore?.Clear();

        var result = await apiClient.Save(user);
        if (!result.HasErrors)
        {
            NavManager.NavigateTo("/users");
            return;
        }

        foreach (var error in result.Errors)
        {
            messageStore?.Add(new FieldIdentifier(user, string.Empty), error);
        }

        foreach (var error in result.PropertyErrors)
        {
            var propertyName = error.Key[0].ToString().ToUpper() + error.Key.Substring(1);
            messageStore?.Add(new FieldIdentifier(user, propertyName), error.Value);
        }

        // Teavita EditForm'i, et vead on muutunud
        editContext?.NotifyValidationStateChanged();
    }
}
